# Optional — overrides auto-detected Vercel URL for sitemap generation and baked-in meta.
# Vercel builds usually do not need this; VERCEL_PROJECT_PRODUCTION_URL is used automatically.
# VITE_SITE_URL=https://your-project.vercel.app

# Web3Forms access key — enables the contact form on /contact (get one at https://web3forms.com)
# VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here
